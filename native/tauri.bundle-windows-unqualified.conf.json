{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Affect Research Suite",
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
      "resources": {
        "icons-ledger/icon.ico": "resources/icons/planner-ledger.ico",
        "runner-icons/icon.ico": "resources/icons/experiment-runner.ico",
        "target/release/affect-runner.exe": "resources/bin/affect-runner.exe",
        "windows/affect-research-suite-root.json": "resources/affect-research-suite-root.json"
      },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Affect Research",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "shortDescription": "Experiment Planner and Experiment Runner desktop suite",
    "longDescription": "One self-contained Windows suite containing the separate Experiment Planner, Experiment Planner Ledger, and Experiment Runner applications. Research qualification remains separately gated."
  }
}
