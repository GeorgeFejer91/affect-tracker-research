+void MainInterface::applyFlubberCommand( const QString &command )
+{
+    if( !flubberPanel ) return;
+    const int space = command.indexOf( QLatin1Char( ' ' ) );
+    const QString verb = ( space < 0 ? command : command.left( space ) ).trimmed().toLower();
+    const QString arg = space < 0 ? QString() : command.mid( space + 1 ).trimmed();
+    QString error;
+    if( verb == QLatin1String( "primary" ) &&
+        ( arg == QLatin1String( "flubber" ) || arg == QLatin1String( "grid" ) ||
+          arg == QLatin1String( "face" ) ) )
+        flubberPanel->setPrimary( FlubberPanel::kindFromName( arg ) );
+    else if( verb == QLatin1String( "input" ) &&
+             ( arg == QLatin1String( "arrows" ) || arg == QLatin1String( "mouse" ) ) )
+        flubberPanel->setArrowMode( arg == QLatin1String( "arrows" ) );
+    else if( verb == QLatin1String( "visible" ) )
+    {
+        const QStringList parts = arg.split( QLatin1Char( ' ' ), Qt::SkipEmptyParts );
+        if( parts.size() == 2 &&
+            ( parts[0] == QLatin1String( "flubber" ) || parts[0] == QLatin1String( "grid" ) ||
+              parts[0] == QLatin1String( "face" ) ) &&
+            ( parts[1] == QLatin1String( "on" ) || parts[1] == QLatin1String( "off" ) ) )
+            flubberPanel->setVisible( FlubberPanel::kindFromName( parts[0] ),
+                                      parts[1] == QLatin1String( "on" ) );
+        else error = tr( "Use: visible flubber|grid|face on|off" );
+    }
+    else if( verb == QLatin1String( "face" ) && !arg.isEmpty() )
+        flubberPanel->setFaceId( arg, &error );
+    else if( verb == QLatin1String( "load" ) && !arg.isEmpty() )
+        flubberPanel->loadSettingsFile( arg, error );
+    else error = tr( "Use: primary flubber|grid|face; input arrows|mouse; "
+                     "visible flubber|grid|face on|off; face <preset>; load <JSON path>" );
+    if( !error.isEmpty() )
+    {
+        msg_Err( p_intf, "Flubber command rejected: %s", qtu( error ) );
+        QMessageBox::warning( this, tr( "Flubber command rejected" ), error );
+    }
+}
+
+void MainInterface::sampleFlubber()
+{
+    if( !flubberBridge || !flubberBridge->ready() || !flubberPanel ) return;
+    input_thread_t *input = THEMIM->getInput();
+    int state = 0;
+    qint64 mediaMs = 0;
+    QByteArray name( "video" );
+    QByteArray path;
+    if( input )
+    {
+        const int vlcState = var_GetInteger( input, "state" );
+        if( vlcState == PLAYING_S ) state = 3;
+        else if( vlcState == PAUSE_S ) state = 4;
+        else if( vlcState == OPENING_S ) state = 2;
+        else if( vlcState == END_S ) state = 6;
+        else if( vlcState == ERROR_S ) state = 7;
+        mediaMs = qMax<qint64>( 0, var_GetInteger( input, "time" ) / 1000 );
+        input_item_t *item = input_GetItem( input );
+        if( item )
+        {
+            char *rawUri = input_item_GetURI( item );
+            if( rawUri )
+            {
+                const QUrl uri = QUrl::fromEncoded( QByteArray( rawUri ) );
+                if( uri.isLocalFile() )
+                {
+                    const QString local = uri.toLocalFile();
+                    path = QDir::toNativeSeparators( local ).toUtf8();
+                    name = QFileInfo( local ).fileName().toUtf8();
+                }
+                else if( !uri.fileName().isEmpty() ) name = uri.fileName().toUtf8();
+                free( rawUri );
+            }
+        }
+    }
+    /* The old input may disappear between GUI polls at natural end. Keep its
+     * terminal status for three sampler ticks so the Rust worker observes End
+     * or Error once before a following playlist item begins. */
+    if( flubberTerminalTicks > 0 )
+    {
+        state = flubberTerminalState;
+        --flubberTerminalTicks;
+    }
+    const int result = flubberBridge->update( flubberPanel->valence(), flubberPanel->arousal(),
+                                               state, mediaMs, name, path );
+    if( ( result != 0 || flubberBridge->status() < 0 ) && !flubberFailureReported )
+    {
+        flubberFailureReported = true;
+        msg_Err( p_intf, "Flubber LSL/CSV bridge stopped" );
+        QMessageBox::warning( this, tr( "Flubber recording stopped" ),
+            tr( "The Flubber LSL/CSV worker stopped. Playback continues, but affect data is not recording.\n%1" )
+                .arg( flubberBridge->error() ) );
+    }
+}
+
+void MainInterface::flubberPlaybackStateChanged( int state )
+{
+    if( state == END_S || state == ERROR_S )
+    {
+        /* InputManager also emits END_S when it merely drops an input after
+         * Stop/Next. Only a still-live input in that core state proves a
+         * natural end or playback error. */
+        input_thread_t *input = THEMIM->getInput();
+        if( !input || var_GetInteger( input, "state" ) != state ) return;
+        flubberTerminalState = state == END_S ? 6 : 7;
+        flubberTerminalTicks = 3;
+        sampleFlubber();
+    }
+}
