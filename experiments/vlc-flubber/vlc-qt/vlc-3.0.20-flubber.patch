@@ -111,6 +111,31 @@ static void PrioritizeSystem32(void)
     SetProcessMitigationPolicy( 10 /* ProcessImageLoadPolicy */, &m, sizeof( m ) );
 }
 
+/* Retain the packaged Qt dependencies for VLC's system32-only module loader. */
+static BOOL PreloadFlubberQt(void)
+{
+    wchar_t path[MAX_PATH];
+    DWORD n = GetModuleFileNameW(NULL, path, MAX_PATH);
+    if (n == 0 || n >= MAX_PATH)
+        return FALSE;
+    wchar_t *name = wcsrchr(path, L'\\');
+    if (name == NULL)
+        return FALSE;
+    ++name;
+    static const wchar_t *const deps[] = {
+        L"Qt5Core.dll", L"Qt5Gui.dll", L"Qt5Widgets.dll", L"Qt5Svg.dll"
+    };
+    for (size_t i = 0; i < sizeof(deps) / sizeof(deps[0]); ++i)
+    {
+        if (wcslen(deps[i]) >= MAX_PATH - (size_t)(name - path))
+            return FALSE;
+        wcscpy(name, deps[i]);
+        if (LoadLibraryExW(path, NULL,
+                LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_SYSTEM32) == NULL)
+            return FALSE;
+    }
+    return TRUE;
+}
 /*
  * Export WinMain to force GNU ld to generate a .reloc section
  */
