+                          [mi, i]() { mi->setFlubberPrimary( i ); } );
+    }
+    QMenu *shown = flubberMenu->addMenu( qtr( "Show elements" ) );
+    QAction *visibleActions[3];
+    for( int i = 0; i < 3; ++i )
+    {
+        visibleActions[i] = shown->addAction( qtr( feedbackNames[i] ) );
+        visibleActions[i]->setCheckable( true );
+        visibleActions[i]->setShortcut( QKeySequence( QString( "Ctrl+Alt+%1" ).arg( i + 1 ) ) );
+        visibleActions[i]->setShortcutContext( Qt::WidgetShortcut );
+        QAction *action = visibleActions[i];
+        QObject::connect( visibleActions[i], &QAction::triggered, mi,
+                          [mi, i, action]() {
+            mi->setFlubberVisible( i, !mi->flubberVisible( i ) );
+            action->setChecked( mi->flubberVisible( i ) );
+        } );
+    }
+    QObject::connect( flubberMenu, &QMenu::aboutToShow, mi,
+                      [mi, feedbackActions, visibleActions]() {
+        feedbackActions[mi->flubberPrimary()]->setChecked( true );
+        for( int i = 0; i < 3; ++i )
+            visibleActions[i]->setChecked( mi->flubberVisible( i ) );
+    } );
+    flubberMenu->addSeparator();
+    QActionGroup *flubberInput = new QActionGroup( flubberMenu );
+    QAction *arrowInput = flubberMenu->addAction( qtr( "&Arrow-key control" ), mi,
+                                                 SLOT( useFlubberArrows() ) );
+    arrowInput->setShortcut( QKeySequence( "Ctrl+Shift+A" ) );
+    arrowInput->setCheckable( true );
+    flubberInput->addAction( arrowInput );
+    QAction *mouseInput = flubberMenu->addAction( qtr( "&Mouse control" ), mi,
+                                                 SLOT( useFlubberMouse() ) );
+    mouseInput->setShortcut( QKeySequence( "Ctrl+Shift+M" ) );
+    mouseInput->setCheckable( true );
+    flubberInput->addAction( mouseInput );
+    QObject::connect( flubberMenu, &QMenu::aboutToShow, mi,
+                      [mi, arrowInput, mouseInput]() {
+        ( mi->flubberUsesArrows() ? arrowInput : mouseInput )->setChecked( true );
+    } );
+    addMenuToMainbar( flubberMenu, qtr( "&Flubber" ), bar );
+
     addMenuToMainbar( HelpMenu( bar ), qtr( "&Help" ), bar );
 
 }
