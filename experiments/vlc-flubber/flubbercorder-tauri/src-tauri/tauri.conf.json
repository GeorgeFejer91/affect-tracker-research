{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlubberRecorder",
  "mainBinaryName": "FlubberRecorder",
  "version": "0.1.0",
  "identifier": "io.github.georgefejer91.flubbercorder",
  "build": { "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "recorder",
      "title": "FlubberRecorder",
      "width": 980,
      "height": 700,
      "minWidth": 680,
      "minHeight": 500,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'; object-src 'none'; frame-src 'none'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "category": "Education",
    "icon": ["icons/icon.ico"],
    "shortDescription": "Local FlubberRecorder companion",
    "windows": { "nsis": { "installerHooks": "./windows/player-dependency.nsh" } }
  }
}
