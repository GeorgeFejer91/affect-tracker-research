{
  "name": "affect-tracker-research",
  "version": "0.4.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Local-first continuous video affect research instrument.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeorgeFejer91/affect-tracker-research.git"
  },
  "homepage": "https://GeorgeFejer91.github.io/affect-tracker-research/",
  "scripts": {
    "test": "node --test test/math.test.js test/app-logo-concepts.test.js test/axis-bloom-variants.test.js test/research-*.test.js",
    "test:research": "node --test test/math.test.js test/app-logo-concepts.test.js test/axis-bloom-variants.test.js test/research-*.test.js",
    "test:web": "node --test test/math.test.js test/app-logo-concepts.test.js test/axis-bloom-variants.test.js test/research-*.test.js",
    "build:pages": "node scripts/build-research-pages.js && node scripts/verify-research-build.js pages",
    "serve": "python -m http.server 8000 --directory site",
    "qualification:browser:serve": "python -m http.server 8013 --bind 127.0.0.1 --directory .",
    "desktop:dev": "vite --config desktop/vite.config.js",
    "desktop:build": "vite build --config desktop/vite.config.js && node scripts/verify-research-build.js desktop",
    "desktop:preview": "vite preview --config desktop/vite.config.js",
    "desktop:icons": "tauri icon desktop/icons/app-icon.svg -o src-tauri/icons",
    "desktop:logos:build": "node scripts/build-app-logo-concepts.mjs",
    "desktop:logos:check": "node scripts/build-app-logo-concepts.mjs --check",
    "desktop:logos:axis:build": "node scripts/build-axis-bloom-variants.mjs",
    "desktop:logos:axis:check": "node scripts/build-axis-bloom-variants.mjs --check",
    "desktop:logo:select": "node scripts/select-app-logo.mjs",
    "desktop:bundle": "node scripts/build-unqualified-desktop-package.js windows-x64"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/cli": "2.11.4",
    "esbuild": "0.28.1",
    "vite": "8.2.2"
  }
}
